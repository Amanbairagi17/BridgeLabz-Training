use mysqlpractice1;

-- insert data 
insert into visits
(patient_id, doctor_name, diagnosis, visit_date)
values
(1, 'Dr. Sharma', 'viral fever', curdate());
 
 -- show data tables
 select * from visits;
 
 -- view patient history
 select
    doctor_name,
    diagnosis,
    visit_date
from visits
where patient_id = 1
order by visit_date desc;

-- add persciption details
update visits
set diagnosis = 'cold – paracetamol 500mg for 5 days'
where visit_id = 3;

-- add one mote column 
alter table visits
add prescription varchar(255);

update visits
set prescription = 'paracetamol 500mg, 2 times a day for 5 days'
where visit_id = 3;



